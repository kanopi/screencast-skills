#!/usr/bin/env bash
# Kanopi brand preset for screencast-tutorial-video.
# Enable with:  export TUT_PRESET=kanopi   (before running any script)
#
# Sets Kanopi's house voice, tone, and format defaults. The parts that can't be
# an env var, the pronunciation lexicon, the intro/outro pattern, and the brand
# look, are documented in presets/kanopi-brand.md and applied per video.
#
# Every value uses ${VAR:-default}, so an explicit environment variable still wins.

export TUT_TTS="${TUT_TTS:-openai}"
export TUT_VOICE="${TUT_VOICE:-marin}"
export TUT_TTS_INSTRUCTIONS="${TUT_TTS_INSTRUCTIONS:-Clear, friendly, professional narration for a Kanopi internal training video. Steady and unhurried.}"
export TUT_RES="${TUT_RES:-1920x1080}"
export TUT_FPS="${TUT_FPS:-25}"
